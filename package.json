{
  "name": "veylo-ai",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 127.0.0.1 --port 1420 --strictPort",
    "build": "tsc --noEmit && vite build",
    "check:backdrop": "npm.cmd run build && node scripts/check-backdrop-build.mjs",
    "preview": "vite preview --host 127.0.0.1 --port 1421 --strictPort",
    "tauri": "node scripts/tauri.mjs",
    "desktop": "node scripts/tauri.mjs dev",
    "desktop:build": "node scripts/tauri.mjs build",
    "desktop:app": "node scripts/tauri.mjs build --debug --no-bundle",
    "check:rust": "node scripts/check-rust.mjs",
    "test:translation:live": "node scripts/live-translation.mjs",
    "doctor": "node scripts/doctor.mjs",
    "test": "node scripts/test.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.0.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "typescript": "^5.9.0",
    "vite": "^7.0.0",
    "tsx": "^4.0.0"
  }
}
